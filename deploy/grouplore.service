[Unit]
Description=GroupLore Next.js server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grouplore
Group=grouplore
WorkingDirectory=/srv/grouplore/current
EnvironmentFile=/etc/grouplore.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
