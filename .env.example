# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ── Engine ──
# HMAC secret for reconnect seat tokens. Set a long random value in production.
SESSION_SECRET=replace-with-a-long-random-string
# Guests use Supabase anonymous auth. Set false to reject anonymous tokens
# on both HTTP and Socket.io, and disable Anonymous sign-ins in Supabase.
ALLOW_GUESTS=true
# Lore profile prompts are optional and off by default.
LORE_MODE=false

# ── UploadThing ──
UPLOADTHING_TOKEN=your-uploadthing-token

# ── Server ──
PORT=3001
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
